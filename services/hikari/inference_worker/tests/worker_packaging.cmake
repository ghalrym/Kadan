# Exercise the real packaging function with a fake install boundary: no CUDA,
# compiled fixture, dependency resolution or inference execution is needed.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../CMakeLists.txt" source)
string(FIND "${source}" "function(kadan_install_worker target)" start)
if(start EQUAL -1)
  message(FATAL_ERROR "Worker packaging function was not found")
endif()
string(SUBSTRING "${source}" ${start} -1 source)
string(FIND "${source}" "endfunction()" end)
math(EXPR length "${end} + 13")
string(SUBSTRING "${source}" 0 ${length} definition)

function(install)
  if(ARGV0 STREQUAL "TARGETS")
    cmake_parse_arguments(rule "" "" "PRE_EXCLUDE_REGEXES;POST_EXCLUDE_REGEXES" ${ARGV})
    set_property(GLOBAL PROPERTY worker_pre_excludes "${rule_PRE_EXCLUDE_REGEXES}")
  endif()
endfunction()

cmake_language(EVAL CODE "${definition}")
kadan_install_worker(fake-worker)
get_property(excludes GLOBAL PROPERTY worker_pre_excludes)
foreach(library IN ITEMS libcuda.so.1 libcudart.so.13 libcublas.so.13 libcuda.so.10)
  set(excluded FALSE)
  foreach(pattern IN LISTS excludes)
    if(library MATCHES "${pattern}")
      set(excluded TRUE)
    endif()
  endforeach()
  if(library STREQUAL "libcuda.so.1")
    if(NOT excluded)
      message(FATAL_ERROR "Host driver dependency must be pre-excluded")
    endif()
  elseif(excluded)
    message(FATAL_ERROR "Bundled runtime dependency unexpectedly excluded: ${library}")
  endif()
endforeach()
