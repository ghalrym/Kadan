# Correctness/comparator test overlay; never the production image.
# Isolated test packaging only. Build from an immutable git archive of repo root.
# Toolchain is a registry digest; API is a verified ID-derived local tag or digest.
# TOOLCHAIN_IMAGE: pinned CUDA 13.0.2 devel Ubuntu22.04 amd64 (GCC/make included).
# CMake is the official release archive, checked against its published checksum.
ARG TOOLCHAIN_IMAGE
ARG API_IMAGE
FROM ${TOOLCHAIN_IMAGE} AS native-build
ADD https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-x86_64.tar.gz /tmp/cmake.tar.gz
RUN echo "5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf  /tmp/cmake.tar.gz" | sha256sum -c - \
    && mkdir /opt/cmake && tar -xzf /tmp/cmake.tar.gz -C /opt/cmake --strip-components=1 \
    && rm /tmp/cmake.tar.gz
ENV PATH=/opt/cmake/bin:${PATH}
WORKDIR /src
COPY native/ /src/native/
RUN cmake -S native -B /build -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_TESTING=OFF -DKADAN_ENABLE_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=86 \
      -DCMAKE_EXE_LINKER_FLAGS="-static-libstdc++ -static-libgcc" \
    && cmake --build /build --target kadan-model-worker kadan-model-correctness kadan-model-compare --parallel 2 \
    && mkdir -p /out/bin /out/lib \
    && cp /build/kadan-model-worker /build/kadan-model-correctness /build/kadan-model-compare /out/bin/ \
    && cp -L /usr/local/cuda/lib64/libcudart.so.13 /out/lib/libcudart.so.13 \
    && (cd /out && sha256sum bin/kadan-model-worker bin/kadan-model-correctness bin/kadan-model-compare lib/libcudart.so.13 > SHA256SUMS)

# Use the reviewed full Kadan API dependency image, not a bare Python/CUDA image.
FROM ${API_IMAGE} AS native-api-test
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
WORKDIR /app
RUN rm -rf /app/api
COPY api/ /app/api/
COPY --from=native-build /out/ /opt/kadan/
# Only the worker gets this runtime lookup path; preserve Torch's runtime selection.
RUN printf '#!/bin/sh\nLD_LIBRARY_PATH=/opt/kadan/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} exec /opt/kadan/bin/kadan-model-worker "$@"\n' > /opt/kadan/bin/run-model-worker \
    && chmod 0555 /opt/kadan/bin/run-model-worker \
    && cd /opt/kadan && sha256sum -c SHA256SUMS \
    && LD_LIBRARY_PATH=/opt/kadan/lib ldd /opt/kadan/bin/kadan-model-worker > /opt/kadan/LINKAGE.txt \
    && LD_LIBRARY_PATH=/opt/kadan/lib ldd /opt/kadan/bin/kadan-model-correctness >> /opt/kadan/LINKAGE.txt \
    && ldd /opt/kadan/bin/kadan-model-compare >> /opt/kadan/LINKAGE.txt \
    && ! grep -E 'not found|version .* not found' /opt/kadan/LINKAGE.txt
# No API startup, CUDA initialization, checkpoint access, or inference during build.
# Backend remains opt-in at run time. No GPU budget or model selection is baked in.
ENV KADAN_NATIVE_WORKER=/opt/kadan/bin/run-model-worker
CMD ["python", "-m", "api"]
