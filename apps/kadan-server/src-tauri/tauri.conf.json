{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadan Server",
  "version": "0.1.0",
  "identifier": "ai.kadan.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kadan Server",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
