{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadan",
  "version": "0.1.0",
  "identifier": "ai.kadan.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../../services/frontend run build",
    "frontendDist": "../../../services/frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../services/frontend/dist": "web"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
