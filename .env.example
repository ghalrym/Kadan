# Local database credentials. Compose keeps Postgres on its internal network.
POSTGRES_DB=kadan
POSTGRES_USER=kadan
POSTGRES_PASSWORD=kadan

# Hikari retains these database names and the kadan Compose project for existing data.
# Keep COMPOSE_PROJECT_NAME (or -p) if your deployment already uses a custom name.

# Browser interfaces bind to all host interfaces. Kadan is the primary entry point.
KADAN_PORT=8630
TSUCHI_PORT=8620
HIKARI_FRONTEND_PORT=8088
TSUCHI_MAX_UPLOAD_BYTES=104857600
# Existing standalone Tsuchi volume. Use a different name for an isolated installation.
TSUCHI_DATA_VOLUME=tsuchi_tsuchi_data

# Shared API key for Hikari worker containers connecting to /v1/workers, here or
# on other computers. Defaults to insecure-api-key; override if needed.
HIKARI_WORKER_TOKEN=insecure-api-key
# Positive seconds after the last request completes before an idle model unloads.
HIKARI_MODEL_IDLE_SECONDS=3600
# Workers default to the API in this Compose project. On another computer, set
# HIKARI_API_URL=ws://API_HOST:8000/v1/workers and start workers with --no-deps.
# To reuse an existing remote-worker store, also set
# HIKARI_MODEL_VOLUME=kadan-workers_worker_models and use -p kadan-workers.

# API key between Kadan and the agent's computer (kadan-sandbox);
# defaults to insecure-api-key; override if needed.
KADAN_SANDBOX_API_KEY=insecure-api-key

# Stable logical-agent owner. Idle agents retain their slots.
# The optional runners profile adds a second owner with the fixed ID runner-2.
KADAN_RUNNER_ID=runner-1
# Strict positive integer; default is five assigned agents, including idle agents.
KADAN_RUNNER_CAPACITY=5
