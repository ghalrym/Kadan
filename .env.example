# Plain `docker compose` commands use the hot-reload development override.
# Remove this line to run the production nginx frontends and baked API images.
COMPOSE_FILE=compose.yaml:compose.development.yaml

# Local development credentials. Compose keeps Postgres on its internal network.
POSTGRES_DB=kadan
POSTGRES_USER=kadan
POSTGRES_PASSWORD=kadan

# Hikari retains these database names and the kadan Compose project for existing data.
# Keep COMPOSE_PROJECT_NAME (or -p) if your deployment already uses a custom name.

# Browser interfaces bind only to 127.0.0.1. Kadan is the primary entry point.
KADAN_PORT=8630
TSUCHI_PORT=8620
HIKARI_FRONTEND_PORT=8088
TSUCHI_MAX_UPLOAD_BYTES=104857600
# Existing standalone Tsuchi volume. Use a different name for an isolated installation.
TSUCHI_DATA_VOLUME=tsuchi_tsuchi_data
