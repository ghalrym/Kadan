{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "standard",
      "stream": "ext://sys.stderr"
    },
    "durable": {
      "class": "durable_evidence.ImageEvents",
      "path": "/run/kadan-window-evidence/image-events.jsonl"
    }
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ],
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ],
      "propagate": false
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ],
      "propagate": false
    },
    "api.services.images": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "durable"
      ],
      "propagate": false
    },
    "api.inference.image.dual": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "durable"
      ],
      "propagate": false
    },
    "api.inference.image.rank_transport": {
      "level": "INFO",
      "handlers": [
        "stderr",
        "durable"
      ],
      "propagate": false
    },
    "api.memory_manager": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": [
      "stderr"
    ]
  }
}
